// Generated by tools/generate_time_tests.py; expectations come from OTIO.

///|
fn assert_near(actual : Double, expected : Double) -> Unit raise {
  assert_true((actual - expected).abs() <= 1.0e-12 * (1.0 + expected.abs()))
}

///|
test "OTIO vector 000" {
  let time = @time.RationalTime::new(48.0, 24.0).unwrap()
  assert_near(time.to_seconds().unwrap(), 2.0)
  let converted = time.rescaled_to(30.0).unwrap()
  assert_near(converted.value(), 60.0)
  assert_eq(converted.rate(), 30.0)
  let restored = converted.rescaled_to(24.0).unwrap()
  assert_near(restored.value(), 48.0)
}

