test "collections:SerializableCollection-reverse" {
  let original = @schema.read(
    "{\n    \"OTIO_SCHEMA\": \"SerializableCollection.1\",\n    \"metadata\": {\n        \"keep\": {\n            \"nested\": [\n                1,\n                2,\n                3\n            ]\n        }\n    },\n    \"name\": \"keep\",\n    \"children\": [\n        {\n            \"OTIO_SCHEMA\": \"Clip.2\",\n            \"metadata\": {},\n            \"name\": \"a\",\n            \"source_range\": null,\n            \"effects\": [],\n            \"markers\": [],\n            \"enabled\": true,\n            \"color\": null,\n            \"media_references\": {\n                \"DEFAULT_MEDIA\": {\n                    \"OTIO_SCHEMA\": \"MissingReference.1\",\n                    \"metadata\": {},\n                    \"name\": \"\",\n                    \"available_range\": null,\n                    \"available_image_bounds\": null\n                }\n            },\n            \"active_media_reference_key\": \"DEFAULT_MEDIA\"\n        },\n        {\n            \"OTIO_SCHEMA\": \"Gap.1\",\n            \"metadata\": {},\n            \"name\": \"gap\",\n            \"source_range\": {\n                \"OTIO_SCHEMA\": \"TimeRange.1\",\n                \"duration\": {\n                    \"OTIO_SCHEMA\": \"RationalTime.1\",\n                    \"rate\": 1.0,\n                    \"value\": 0.0\n                },\n                \"start_time\": {\n                    \"OTIO_SCHEMA\": \"RationalTime.1\",\n                    \"rate\": 1.0,\n                    \"value\": 0.0\n                }\n            },\n            \"effects\": [],\n            \"markers\": [],\n            \"enabled\": true,\n            \"color\": null\n        },\n        {\n            \"OTIO_SCHEMA\": \"Clip.2\",\n            \"metadata\": {},\n            \"name\": \"b\",\n            \"source_range\": null,\n            \"effects\": [],\n            \"markers\": [],\n            \"enabled\": true,\n            \"color\": null,\n            \"media_references\": {\n                \"DEFAULT_MEDIA\": {\n                    \"OTIO_SCHEMA\": \"MissingReference.1\",\n                    \"metadata\": {},\n                    \"name\": \"\",\n                    \"available_range\": null,\n                    \"available_image_bounds\": null\n                }\n            },\n            \"active_media_reference_key\": \"DEFAULT_MEDIA\"\n        }\n    ]\n}",
  ).unwrap()
  let g = @graph.Graph::new(original)
  assert_true(
    g
    .reversed_children([])
    .unwrap()
    .root()
    .equivalent(
      @schema.read(
        "{\n    \"OTIO_SCHEMA\": \"SerializableCollection.1\",\n    \"metadata\": {\n        \"keep\": {\n            \"nested\": [\n                1,\n                2,\n                3\n            ]\n        }\n    },\n    \"name\": \"keep\",\n    \"children\": [\n        {\n            \"OTIO_SCHEMA\": \"Clip.2\",\n            \"metadata\": {},\n            \"name\": \"b\",\n            \"source_range\": null,\n            \"effects\": [],\n            \"markers\": [],\n            \"enabled\": true,\n            \"color\": null,\n            \"media_references\": {\n                \"DEFAULT_MEDIA\": {\n                    \"OTIO_SCHEMA\": \"MissingReference.1\",\n                    \"metadata\": {},\n                    \"name\": \"\",\n                    \"available_range\": null,\n                    \"available_image_bounds\": null\n                }\n            },\n            \"active_media_reference_key\": \"DEFAULT_MEDIA\"\n        },\n        {\n            \"OTIO_SCHEMA\": \"Gap.1\",\n            \"metadata\": {},\n            \"name\": \"gap\",\n            \"source_range\": {\n                \"OTIO_SCHEMA\": \"TimeRange.1\",\n                \"duration\": {\n                    \"OTIO_SCHEMA\": \"RationalTime.1\",\n                    \"rate\": 1.0,\n                    \"value\": 0.0\n                },\n                \"start_time\": {\n                    \"OTIO_SCHEMA\": \"RationalTime.1\",\n                    \"rate\": 1.0,\n                    \"value\": 0.0\n                }\n            },\n            \"effects\": [],\n            \"markers\": [],\n            \"enabled\": true,\n            \"color\": null\n        },\n        {\n            \"OTIO_SCHEMA\": \"Clip.2\",\n            \"metadata\": {},\n            \"name\": \"a\",\n            \"source_range\": null,\n            \"effects\": [],\n            \"markers\": [],\n            \"enabled\": true,\n            \"color\": null,\n            \"media_references\": {\n                \"DEFAULT_MEDIA\": {\n                    \"OTIO_SCHEMA\": \"MissingReference.1\",\n                    \"metadata\": {},\n                    \"name\": \"\",\n                    \"available_range\": null,\n                    \"available_image_bounds\": null\n                }\n            },\n            \"active_media_reference_key\": \"DEFAULT_MEDIA\"\n        }\n    ]\n}",
      ).unwrap(),
    ),
  )
}

///|
test "collections:SerializableCollection-remove" {
  let original = @schema.read(
    "{\n    \"OTIO_SCHEMA\": \"SerializableCollection.1\",\n    \"metadata\": {\n        \"keep\": {\n            \"nested\": [\n                1,\n                2,\n                3\n            ]\n        }\n    },\n    \"name\": \"keep\",\n    \"children\": [\n        {\n            \"OTIO_SCHEMA\": \"Clip.2\",\n            \"metadata\": {},\n            \"name\": \"a\",\n            \"source_range\": null,\n            \"effects\": [],\n            \"markers\": [],\n            \"enabled\": true,\n            \"color\": null,\n            \"media_references\": {\n                \"DEFAULT_MEDIA\": {\n                    \"OTIO_SCHEMA\": \"MissingReference.1\",\n                    \"metadata\": {},\n                    \"name\": \"\",\n                    \"available_range\": null,\n                    \"available_image_bounds\": null\n                }\n            },\n            \"active_media_reference_key\": \"DEFAULT_MEDIA\"\n        },\n        {\n            \"OTIO_SCHEMA\": \"Gap.1\",\n            \"metadata\": {},\n            \"name\": \"gap\",\n            \"source_range\": {\n                \"OTIO_SCHEMA\": \"TimeRange.1\",\n                \"duration\": {\n                    \"OTIO_SCHEMA\": \"RationalTime.1\",\n                    \"rate\": 1.0,\n                    \"value\": 0.0\n                },\n                \"start_time\": {\n                    \"OTIO_SCHEMA\": \"RationalTime.1\",\n                    \"rate\": 1.0,\n                    \"value\": 0.0\n                }\n            },\n            \"effects\": [],\n            \"markers\": [],\n            \"enabled\": true,\n            \"color\": null\n        },\n        {\n            \"OTIO_SCHEMA\": \"Clip.2\",\n            \"metadata\": {},\n            \"name\": \"b\",\n            \"source_range\": null,\n            \"effects\": [],\n            \"markers\": [],\n            \"enabled\": true,\n            \"color\": null,\n            \"media_references\": {\n                \"DEFAULT_MEDIA\": {\n                    \"OTIO_SCHEMA\": \"MissingReference.1\",\n                    \"metadata\": {},\n                    \"name\": \"\",\n                    \"available_range\": null,\n                    \"available_image_bounds\": null\n                }\n            },\n            \"active_media_reference_key\": \"DEFAULT_MEDIA\"\n        }\n    ]\n}",
  ).unwrap()
  let g = @graph.Graph::new(original)
  ignore(g)
  let children = original.children().unwrap()
  children.remove(1) |> ignore
  assert_true(
    original
    .with_children(children)
    .unwrap()
    .equivalent(
      @schema.read(
        "{\n    \"OTIO_SCHEMA\": \"SerializableCollection.1\",\n    \"metadata\": {\n        \"keep\": {\n            \"nested\": [\n                1,\n                2,\n                3\n            ]\n        }\n    },\n    \"name\": \"keep\",\n    \"children\": [\n        {\n            \"OTIO_SCHEMA\": \"Clip.2\",\n            \"metadata\": {},\n            \"name\": \"a\",\n            \"source_range\": null,\n            \"effects\": [],\n            \"markers\": [],\n            \"enabled\": true,\n            \"color\": null,\n            \"media_references\": {\n                \"DEFAULT_MEDIA\": {\n                    \"OTIO_SCHEMA\": \"MissingReference.1\",\n                    \"metadata\": {},\n                    \"name\": \"\",\n                    \"available_range\": null,\n                    \"available_image_bounds\": null\n                }\n            },\n            \"active_media_reference_key\": \"DEFAULT_MEDIA\"\n        },\n        {\n            \"OTIO_SCHEMA\": \"Clip.2\",\n            \"metadata\": {},\n            \"name\": \"b\",\n            \"source_range\": null,\n            \"effects\": [],\n            \"markers\": [],\n            \"enabled\": true,\n            \"color\": null,\n            \"media_references\": {\n                \"DEFAULT_MEDIA\": {\n                    \"OTIO_SCHEMA\": \"MissingReference.1\",\n                    \"metadata\": {},\n                    \"name\": \"\",\n                    \"available_range\": null,\n                    \"available_image_bounds\": null\n                }\n            },\n            \"active_media_reference_key\": \"DEFAULT_MEDIA\"\n        }\n    ]\n}",
      ).unwrap(),
    ),
  )
}

