///|
test "official image sequence step 1" {
  let seq = @schema.ImageSequence::from_object(
    @schema.read(
      "{\"OTIO_SCHEMA\":\"ImageSequenceReference.1\",\"metadata\":{},\"name\":\"\",\"available_range\":{\"OTIO_SCHEMA\":\"TimeRange.1\",\"duration\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":24.0},\"start_time\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":240.0}},\"available_image_bounds\":null,\"target_url_base\":\"file:///frames\",\"name_prefix\":\"shot.\",\"name_suffix\":\".exr\",\"start_frame\":-2,\"frame_step\":1,\"rate\":24.0,\"frame_zero_padding\":4,\"missing_frame_policy\":\"error\"}",
    ).unwrap(),
  ).unwrap()
  assert_eq(seq.number_of_images(), 24)
  near(seq.end_frame().unwrap(), 21.0)
  assert_eq(seq.target_url(0).unwrap(), "file:///frames/shot.-0002.exr")
  near(seq.presentation_time(0).unwrap().to_seconds().unwrap(), 10.0)
  assert_eq(seq.target_url(1).unwrap(), "file:///frames/shot.-0001.exr")
  near(
    seq.presentation_time(1).unwrap().to_seconds().unwrap(),
    10.041666666666666,
  )
  assert_eq(seq.target_url(23).unwrap(), "file:///frames/shot.0021.exr")
  near(
    seq.presentation_time(23).unwrap().to_seconds().unwrap(),
    10.958333333333334,
  )
  assert_eq(seq.target_url(-1).unwrap(), "file:///frames/shot.-0003.exr")
}

///|
test "official image sequence step 2" {
  let seq = @schema.ImageSequence::from_object(
    @schema.read(
      "{\"OTIO_SCHEMA\":\"ImageSequenceReference.1\",\"metadata\":{},\"name\":\"\",\"available_range\":{\"OTIO_SCHEMA\":\"TimeRange.1\",\"duration\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":24.0},\"start_time\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":240.0}},\"available_image_bounds\":null,\"target_url_base\":\"file:///frames\",\"name_prefix\":\"shot.\",\"name_suffix\":\".exr\",\"start_frame\":-2,\"frame_step\":2,\"rate\":24.0,\"frame_zero_padding\":4,\"missing_frame_policy\":\"error\"}",
    ).unwrap(),
  ).unwrap()
  assert_eq(seq.number_of_images(), 12)
  near(seq.end_frame().unwrap(), 21.0)
  assert_eq(seq.target_url(0).unwrap(), "file:///frames/shot.-0002.exr")
  near(seq.presentation_time(0).unwrap().to_seconds().unwrap(), 10.0)
  assert_eq(seq.target_url(1).unwrap(), "file:///frames/shot.0000.exr")
  near(
    seq.presentation_time(1).unwrap().to_seconds().unwrap(),
    10.083333333333334,
  )
  assert_eq(seq.target_url(11).unwrap(), "file:///frames/shot.0020.exr")
  near(
    seq.presentation_time(11).unwrap().to_seconds().unwrap(),
    10.916666666666666,
  )
  assert_eq(seq.target_url(-1).unwrap(), "file:///frames/shot.-0004.exr")
}

///|
test "official image sequence step 3" {
  let seq = @schema.ImageSequence::from_object(
    @schema.read(
      "{\"OTIO_SCHEMA\":\"ImageSequenceReference.1\",\"metadata\":{},\"name\":\"\",\"available_range\":{\"OTIO_SCHEMA\":\"TimeRange.1\",\"duration\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":24.0},\"start_time\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":240.0}},\"available_image_bounds\":null,\"target_url_base\":\"file:///frames\",\"name_prefix\":\"shot.\",\"name_suffix\":\".exr\",\"start_frame\":-2,\"frame_step\":3,\"rate\":24.0,\"frame_zero_padding\":4,\"missing_frame_policy\":\"error\"}",
    ).unwrap(),
  ).unwrap()
  assert_eq(seq.number_of_images(), 8)
  near(seq.end_frame().unwrap(), 21.0)
  assert_eq(seq.target_url(0).unwrap(), "file:///frames/shot.-0002.exr")
  near(seq.presentation_time(0).unwrap().to_seconds().unwrap(), 10.0)
  assert_eq(seq.target_url(1).unwrap(), "file:///frames/shot.0001.exr")
  near(seq.presentation_time(1).unwrap().to_seconds().unwrap(), 10.125)
  assert_eq(seq.target_url(7).unwrap(), "file:///frames/shot.0019.exr")
  near(seq.presentation_time(7).unwrap().to_seconds().unwrap(), 10.875)
  assert_eq(seq.target_url(-1).unwrap(), "file:///frames/shot.-0005.exr")
}

