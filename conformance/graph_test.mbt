            "{\"OTIO_SCHEMA\":\"Transition.1\",\"metadata\":{\"vendor\":{\"curve\":[0,0.5,1]}},\"name\":\"Dissolve\",\"in_offset\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":24.0},\"out_offset\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":30.0,\"value\":15.0},\"transition_type\":\"SMPTE_Dissolve\"}",
