\"TimeRange.1\",\"duration\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":2400.0},\"start_time\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":0.0}},\"available_image_bounds\":null,\"target_url\":\"A.mov\"}},\"active_media_reference_key\":\"DEFAULT_MEDIA\"},{\"OTIO_SCHEMA\":\"Transition.1\",\"metadata\":{\"vendor\":{\"curve\":[0,0.5,1]}},\"name\":\"Dissolve\",\"in_offset\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":24.0},\"out_offset\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":30.0,\"value\":15.0},\"transition_type\":\"SMPTE_Dissolve\"},{\"OTIO_SCHEMA\":\"Clip.2\",\"metadata\":{\"vendor\":{\"id\":\"B\",\"tags\":[1,null,\"中文\"]}},\"name\":\"B\",\"source_range\":{\"OTIO_SCHEMA\":\"TimeRange.1\",\"duration\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":72.0},\"start_time\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":480.0}},\"effects\":[],\"markers\":[{\"OTIO_SCHEMA\":\"Marker.2\",\"metadata\":{\"review\":[1,2]},\"name\":\"point\",\"color\":\"RED\",\"marked_range\":{\"OTIO_SCHEMA\":\"TimeRange.1\",\"duration\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":0.0},\"start_time\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":504.0}},\"comment\":\"\"},{\"OTIO_SCHEMA\":\"Marker.2\",\"metadata\":{},\"name\":\"crossing\",\"color\":\"RED\",\"marked_range\":{\"OTIO_SCHEMA\":\"TimeRange.1\",\"duration\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":48.0},\"start_time\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":504.0}},\"comment\":\"\"},{\"OTIO_SCHEMA\":\"Marker.2\",\"metadata\":{},\"name\":\"outside\",\"color\":\"RED\",\"marked_range\":{\"OTIO_SCHEMA\":\"TimeRange.1\",\"duration\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":24.0},\"start_time\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":432.0}},\"comment\":\"\"}],\"enabled\":true,\"color\":null,\"media_references\":{\"DEFAULT_MEDIA\":{\"OTIO_SCHEMA\":\"ExternalReference.1\",\"metadata\":{},\"name\":\"\",\"available_range\":{\"OTIO_SCHEMA\":\"TimeRange.1\",\"duration\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":2400.0},\"start_time\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":0.0}},\"available_image_bounds\":null,\"target_url\":\"B.mov\"}},\"active_media_reference_key\":\"DEFAULT_MEDIA\"}],\"kind\":\"Video\"}",
  ).unwrap()
