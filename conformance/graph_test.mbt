test "expand transitions trailing" {
  let track = @schema.read(
    "{\"OTIO_SCHEMA\":\"Track.1\",\"metadata\":{\"track\":{\"notes\":[\"keep\"]}},\"name\":\"V1\",\"source_range\":null,\"effects\":[],\"markers\":[{\"OTIO_SCHEMA\":\"Marker.2\",\"metadata\":{},\"name\":\"track mark\",\"color\":\"RED\",\"marked_range\":{\"OTIO_SCHEMA\":\"TimeRange.1\",\"duration\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":0.0},\"start_time\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":48.0}},\"comment\":\"\"}],\"enabled\":true,\"color\":null,\"children\":[{\"OTIO_SCHEMA\":\"Clip.2\",\"metadata\":{\"vendor\":{\"id\":\"A\",\"tags\":[1,null,\"中文\"]}},\"name\":\"A\",\"source_range\":{\"OTIO_SCHEMA\":\"TimeRange.1\",\"duration\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":96.0},\"start_time\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":240.0}},\"effects\":[],\"markers\":[{\"OTIO_SCHEMA\":\"Marker.2\",\"metadata\":{\"review\":[1,2]},\"name\":\"point\",\"color\":\"RED\",\"marked_range\":{\"OTIO_SCHEMA\":\"TimeRange.1\",\"duration\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":0.0},\"start_time\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":264.0}},\"comment\":\"\"},{\"OTIO_SCHEMA\":\"Marker.2\",\"metadata\":{},\"name\":\"crossing\",\"color\":\"RED\",\"marked_range\":{\"OTIO_SCHEMA\":\"TimeRange.1\",\"duration\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":48.0},\"start_time\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":264.0}},\"comment\":\"\"},{\"OTIO_SCHEMA\":\"Marker.2\",\"metadata\":{},\"name\":\"outside\",\"color\":\"RED\",\"marked_range\":{\"OTIO_SCHEMA\":\"TimeRange.1\",\"duration\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":24.0},\"start_time\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":192.0}},\"comment\":\"\"}],\"enabled\":true,\"color\":null,\"media_references\":{\"DEFAULT_MEDIA\":{\"OTIO_SCHEMA\":\"ExternalReference.1\",\"metadata\":{},\"name\":\"\",\"available_range\":{\"OTIO_SCHEMA\":\"TimeRange.1\",\"duration\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":2400.0},\"start_time\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":0.0}},\"available_image_bounds\":null,\"target_url\":\"A.mov\"}},\"active_media_reference_key\":\"DEFAULT_MEDIA\"},{\"OTIO_SCHEMA\":\"Transition.1\",\"metadata\":{\"vendor\":{\"curve\":[0,0.5,1]}},\"name\":\"Dissolve\",\"in_offset\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":24.0,\"value\":6.0},\"out_offset\":{\"OTIO_SCHEMA\":\"RationalTime.1\",\"rate\":30.0,\"value\":15.0},\"transition_type\":\"SMPTE_Dissolve\"}],\"kind\":\"Video\"}",
  ).unwrap()
  let result = @algorithms.track_with_expanded_transitions(track).unwrap()
