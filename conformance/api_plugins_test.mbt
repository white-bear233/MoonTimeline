}

///|
test "plugins:arguments-read_from_string-False-True-False-none" {
  let failure = "none"
  let events : Array[Json] = []
  fn record(
    name : String,
    args : Json,
    category : String,
  ) -> Result[Unit, String] {
    events.push(
      Json::object({
        "event": Json::string(name),
        "args": @otiojson.clone(args).unwrap(),
      }),
    )
    if failure == category {
      Err("fixture")
    } else {
      Ok(())
    }
  }
  let plugin = @plugins.Plugin::new(
    @schema.read(
      "{\n    \"OTIO_SCHEMA\": \"Adapter.1\",\n    \"filepath\": \"/plugins/fixture.py\",\n    \"name\": \"fixture\",\n    \"suffixes\": []\n}",
    ).unwrap(),
    fn(_d, _n) {
      Ok({
        id: "fixture",
        doc: None,
        functions: {
          "read_from_string": {
            arguments: [],
            doc: None,
            invoke: fn(args) {
              ignore(args)
              match record("read_from_string", args, "adapter") {
                Err(e) => Err(e)
                Ok(_) =>
                  Ok(
                    @otiojson.parse(
                      "{\n    \"OTIO_SCHEMA\": \"Clip.2\",\n    \"metadata\": {},\n    \"name\": \"read\",\n    \"source_range\": null,\n    \"effects\": [],\n    \"markers\": [],\n    \"enabled\": true,\n    \"color\": null,\n    \"media_references\": {\n        \"DEFAULT_MEDIA\": {\n            \"OTIO_SCHEMA\": \"MissingReference.1\",\n            \"metadata\": {},\n            \"name\": \"\",\n            \"available_range\": null,\n            \"available_image_bounds\": null\n        }\n    },\n    \"active_media_reference_key\": \"DEFAULT_MEDIA\"\n}",
                    ).unwrap(),
                  )
              }
            },
          },
          "write_to_string": {
            arguments: [],
            doc: None,
            invoke: fn(args) {
              ignore(args)
              match record("write_to_string", args, "adapter") {
                Err(e) => Err(e)
                Ok(_) => Ok(Json::string("fixture-output"))
              }
            },
          },
          "adapter_hook_names": {
            arguments: [],
            doc: None,
            invoke: fn(args) {
              ignore(args)
              Ok(Json::array([]))
            },
          },
        },
        schema_definitions: Json::empty_object(),
      })
    },
  ).unwrap()
  let services : @plugins.PluginIO = {
    read_file: fn(path) {
      match
        record(
          "file_read",
          Json::object({ "path": Json::string(path) }),
          "file",
        ) {
        Err(e) => Err(e)
        Ok(_) => Ok("fixture-input")
      }
    },
    write_file: fn(path, _text) {
      record("file_write", Json::object({ "path": Json::string(path) }), "file")
    },
    hook: fn(name, j, args) {
      match record(name, args, "hook") {
        Err(e) => return Err(e)
        _ => ()
      }
      match args {
        Object(a) =>
          match a.get("adapter_arguments") {
            Some(Object(a)) =>
              match a.get("nested") {
                Some(Object(n)) => n["keep"] = Json::number(2.0)
                _ => ()
              }
            _ => ()
          }
        _ => ()
      }
      let copy = @otiojson.clone(j).unwrap()
      match copy {
        Object(m) => {
          let old = match m.get("name") {
            Some(String(s)) => s
            _ => ""
          }
          m["name"] = Json::string(old + ":hook")
          Ok(copy)
        }
        _ => Err("invalid")
      }
    },
    link_media: fn(j, name, args) {
      match
        record(
          "link",
          Json::object({ "name": Json::string(name), "arguments": args }),
          "media",
        ) {
        Err(e) => Err(e)
        Ok(_) => Ok(j)
      }
    },
  }
  let result = plugin.read_document(
    "fixture-input",
    services,
    from_file=false,
    adapter_arguments=@otiojson.parse("{}").unwrap(),
    hook_arguments=@otiojson.parse("null").unwrap(),
    media_arguments=@otiojson.parse("null").unwrap(),
    media_linker=Some("fixture"),
  )
  assert_eq(result is Ok(_), true)
  assert_true(
    @otiojson.equivalent(
      Json::array(events),
      @otiojson.parse(
        "[{\"event\":\"read_from_string\",\"args\":{\"hook_function_argument_map\":{\"adapter_arguments\":{},\"media_linker_argument_map\":null},\"input_str\":\"fixture-input\"}},{\"event\":\"post_adapter_read\",\"args\":{\"adapter_arguments\":{},\"media_linker_argument_map\":null}},{\"event\":\"link\",\"args\":{\"arguments\":null,\"name\":\"fixture\"}},{\"event\":\"post_media_linker\",\"args\":{\"adapter_arguments\":{},\"media_linker_argument_map\":null}}]",
      ).unwrap(),
    ),
  )
  assert_true(
    @otiojson.equivalent(
      result.unwrap(),
      @otiojson.parse(
        "{\n    \"OTIO_SCHEMA\": \"Clip.2\",\n    \"metadata\": {},\n    \"name\": \"read:hook:hook\",\n    \"source_range\": null,\n    \"effects\": [],\n    \"markers\": [],\n    \"enabled\": true,\n    \"color\": null,\n    \"media_references\": {\n        \"DEFAULT_MEDIA\": {\n            \"OTIO_SCHEMA\": \"MissingReference.1\",\n            \"metadata\": {},\n            \"name\": \"\",\n            \"available_range\": null,\n            \"available_image_bounds\": null\n        }\n    },\n    \"active_media_reference_key\": \"DEFAULT_MEDIA\"\n}",
      ).unwrap(),
    ),
  )
}

