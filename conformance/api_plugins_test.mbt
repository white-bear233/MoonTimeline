///|
test "plugins:manifest-module-adapter_module_from_name-success" {
  assert_eq(
    @plugins.manifest_module(
      @schema.read(
        "{\n    \"OTIO_SCHEMA\": \"PluginManifest.1\",\n    \"adapters\": [\n        {\n            \"OTIO_SCHEMA\": \"Adapter.1\",\n            \"filepath\": \"/plugins/fixture.py\",\n            \"name\": \"fixture\",\n            \"suffixes\": [\n                \"fixture\"\n            ]\n        }\n    ],\n    \"hook_scripts\": [],\n    \"hooks\": {},\n    \"media_linkers\": [],\n    \"schemadefs\": [],\n    \"version_manifests\": {}\n}",
      ).unwrap(),
      "fixture",
      fn(_descriptor) {
        Ok(@plugins.PluginModule::{
          id: "fixture",
          doc: Some("Fixture module"),
          functions: Map([]),
          schema_definitions: @otiojson.parse("{}").unwrap(),
        })
      },
      kind="adapters",
      by_suffix=false,
    )
    is Ok(_),
    true,
  )
}

