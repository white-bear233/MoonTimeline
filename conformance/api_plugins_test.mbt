///|
test "plugins:pipeline-read_from_string-none" {
  let registry = @plugins.Registry::new()
  let calls : Array[String] = []
  let failure = "none"
  registry
  .register_adapter({
    name: "fixture",
    suffixes: ["fixture"],
    read: fn(text) {
      calls.push("read")
      if failure == "read" {
        Err("fixture_failure")
      } else {
        @otiojson.parse(text)
      }
    },
    write: fn(j) {
      calls.push("write")
      if failure == "write" {
        Err("fixture_failure")
      } else {
        @otiojson.stringify(j)
      }
    },
  })
  .unwrap()
  registry
  .register_hook("post_adapter_read", fn(j, _args) {
    calls.push("post_adapter_read")
    if failure == "post_adapter_read" {
      Err("fixture_failure")
    } else {
      Ok(j)
    }
  })
  .unwrap()
  registry
  .register_hook("post_media_linker", fn(j, _args) {
    calls.push("post_media_linker")
    if failure == "post_media_linker" {
      Err("fixture_failure")
    } else {
      Ok(j)
    }
  })
  .unwrap()
  registry
  .register_hook("pre_adapter_write", fn(j, _args) {
    calls.push("pre_adapter_write")
    if failure == "pre_adapter_write" {
      Err("fixture_failure")
    } else {
      Ok(j)
    }
  })
  .unwrap()
  registry
  .register_hook("post_adapter_write", fn(j, _args) {
    calls.push("post_adapter_write")
    if failure == "post_adapter_write" {
      Err("fixture_failure")
    } else {
      Ok(j)
    }
  })
  .unwrap()
  let result = registry.read(
    "{\n    \"OTIO_SCHEMA\": \"Clip.2\",\n    \"metadata\": {},\n    \"name\": \"keep\",\n    \"source_range\": null,\n    \"effects\": [],\n    \"markers\": [],\n    \"enabled\": true,\n    \"color\": null,\n    \"media_references\": {\n        \"DEFAULT_MEDIA\": {\n            \"OTIO_SCHEMA\": \"MissingReference.1\",\n            \"metadata\": {},\n            \"name\": \"\",\n            \"available_range\": null,\n            \"available_image_bounds\": null\n        }\n    },\n    \"active_media_reference_key\": \"DEFAULT_MEDIA\"\n}",
    adapter="fixture",
  )
  assert_eq(result is Ok(_), true)
  assert_eq(calls, ["read", "post_adapter_read", "post_media_linker"])
  assert_true(
    @otiojson.equivalent(
      result.unwrap(),
      @otiojson.parse(
        "{\n    \"OTIO_SCHEMA\": \"Clip.2\",\n    \"metadata\": {},\n    \"name\": \"keep\",\n    \"source_range\": null,\n    \"effects\": [],\n    \"markers\": [],\n    \"enabled\": true,\n    \"color\": null,\n    \"media_references\": {\n        \"DEFAULT_MEDIA\": {\n            \"OTIO_SCHEMA\": \"MissingReference.1\",\n            \"metadata\": {},\n            \"name\": \"\",\n            \"available_range\": null,\n            \"available_image_bounds\": null\n        }\n    },\n    \"active_media_reference_key\": \"DEFAULT_MEDIA\"\n}",
      ).unwrap(),
    ),
  )
}

