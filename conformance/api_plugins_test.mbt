  assert_true(
    @otiojson.equivalent(
      Json::array(events),
      @otiojson.parse(
        "[{\"event\":\"file_read\",\"args\":{\"path\":\"/fixture.otio\"}},{\"event\":\"read_from_string\",\"args\":{\"hook_function_argument_map\":{\"adapter_arguments\":{},\"media_linker_argument_map\":{}},\"input_str\":\"fixture-input\"}},{\"event\":\"post_adapter_read\",\"args\":{\"adapter_arguments\":{},\"media_linker_argument_map\":{}}},{\"event\":\"link\",\"args\":{\"arguments\":{},\"name\":\"fixture\"}},{\"event\":\"post_media_linker\",\"args\":{}}]",
      ).unwrap(),
    ),
  )
  assert_true(
    @otiojson.equivalent(
      result.unwrap(),
      @otiojson.parse(
        "{\n    \"OTIO_SCHEMA\": \"Clip.2\",\n    \"metadata\": {},\n    \"name\": \"read:hook:hook\",\n    \"source_range\": null,\n    \"effects\": [],\n    \"markers\": [],\n    \"enabled\": true,\n    \"color\": null,\n    \"media_references\": {\n        \"DEFAULT_MEDIA\": {\n            \"OTIO_SCHEMA\": \"MissingReference.1\",\n            \"metadata\": {},\n            \"name\": \"\",\n            \"available_range\": null,\n            \"available_image_bounds\": null\n        }\n    },\n    \"active_media_reference_key\": \"DEFAULT_MEDIA\"\n}",
      ).unwrap(),
    ),
  )
}

