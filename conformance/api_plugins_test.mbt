// Generated from official OTIO 0.18.1 by tools/generate_api_tests.py.

///|
test "plugins:extend-True" {
  let manifest = @schema.read(
    "{\n    \"OTIO_SCHEMA\": \"PluginManifest.1\",\n    \"adapters\": [\n        {\n            \"OTIO_SCHEMA\": \"Adapter.1\",\n            \"filepath\": \"first.py\",\n            \"name\": \"first\",\n            \"suffixes\": [\n                \"otio\"\n            ]\n        },\n        {\n            \"OTIO_SCHEMA\": \"Adapter.1\",\n            \"filepath\": \"dup.py\",\n            \"name\": \"duplicate\",\n            \"suffixes\": [\n                \"same\"\n            ]\n        }\n    ],\n    \"hook_scripts\": [],\n    \"hooks\": {\n        \"post_adapter_read\": [\n            \"one\"\n        ]\n    },\n    \"media_linkers\": [],\n    \"schemadefs\": [\n        {\n            \"OTIO_SCHEMA\": \"SchemaDef.1\",\n            \"filepath\": \"custom.py\",\n            \"name\": \"custom\"\n        }\n    ],\n    \"version_manifests\": {\n        \"family\": {\n            \"v1\": {\n                \"Clip\": 1\n            }\n        }\n    }\n}",
  ).unwrap()
  assert_true(
    @plugins.extend_manifest(manifest, None)
    .unwrap()
    .equivalent(
      @schema.read(
        "{\n    \"OTIO_SCHEMA\": \"PluginManifest.1\",\n    \"adapters\": [\n        {\n            \"OTIO_SCHEMA\": \"Adapter.1\",\n            \"filepath\": \"first.py\",\n            \"name\": \"first\",\n            \"suffixes\": [\n                \"otio\"\n            ]\n        },\n        {\n            \"OTIO_SCHEMA\": \"Adapter.1\",\n            \"filepath\": \"dup.py\",\n            \"name\": \"duplicate\",\n            \"suffixes\": [\n                \"same\"\n            ]\n        }\n    ],\n    \"hook_scripts\": [],\n    \"hooks\": {\n        \"post_adapter_read\": [\n            \"one\"\n        ]\n    },\n    \"media_linkers\": [],\n    \"schemadefs\": [\n        {\n            \"OTIO_SCHEMA\": \"SchemaDef.1\",\n            \"filepath\": \"custom.py\",\n            \"name\": \"custom\"\n        }\n    ],\n    \"version_manifests\": {\n        \"family\": {\n            \"v1\": {\n                \"Clip\": 1\n            }\n        }\n    }\n}",
      ).unwrap(),
    ),
  )
}

///|
test "plugins:extend-False" {
  let manifest = @schema.read(
    "{\n    \"OTIO_SCHEMA\": \"PluginManifest.1\",\n    \"adapters\": [\n        {\n            \"OTIO_SCHEMA\": \"Adapter.1\",\n            \"filepath\": \"first.py\",\n            \"name\": \"first\",\n            \"suffixes\": [\n                \"otio\"\n            ]\n        },\n        {\n            \"OTIO_SCHEMA\": \"Adapter.1\",\n            \"filepath\": \"dup.py\",\n            \"name\": \"duplicate\",\n            \"suffixes\": [\n                \"same\"\n            ]\n        }\n    ],\n    \"hook_scripts\": [],\n    \"hooks\": {\n        \"post_adapter_read\": [\n            \"one\"\n        ]\n    },\n    \"media_linkers\": [],\n    \"schemadefs\": [\n        {\n            \"OTIO_SCHEMA\": \"SchemaDef.1\",\n            \"filepath\": \"custom.py\",\n            \"name\": \"custom\"\n        }\n    ],\n    \"version_manifests\": {\n        \"family\": {\n            \"v1\": {\n                \"Clip\": 1\n            }\n        }\n    }\n}",
  ).unwrap()
  assert_true(
    @plugins.extend_manifest(
      manifest,
      Some(
        @schema.read(
          "{\n    \"OTIO_SCHEMA\": \"PluginManifest.1\",\n    \"adapters\": [\n        {\n            \"OTIO_SCHEMA\": \"Adapter.1\",\n            \"filepath\": \"second.py\",\n            \"name\": \"second\",\n            \"suffixes\": [\n                \"same\",\n                \"extra\"\n            ]\n        }\n    ],\n    \"hook_scripts\": [],\n    \"hooks\": {\n        \"post_adapter_read\": [\n            \"two\"\n        ],\n        \"pre_adapter_write\": [\n            \"three\"\n        ]\n    },\n    \"media_linkers\": [],\n    \"schemadefs\": [],\n    \"version_manifests\": {\n        \"family\": {\n            \"v2\": {\n                \"Clip\": 2\n            }\n        }\n    }\n}",
        ).unwrap(),
      ),
    )
    .unwrap()
    .equivalent(
      @schema.read(
        "{\n    \"OTIO_SCHEMA\": \"PluginManifest.1\",\n    \"adapters\": [\n        {\n            \"OTIO_SCHEMA\": \"Adapter.1\",\n            \"filepath\": \"first.py\",\n            \"name\": \"first\",\n            \"suffixes\": [\n                \"otio\"\n            ]\n        },\n        {\n            \"OTIO_SCHEMA\": \"Adapter.1\",\n            \"filepath\": \"dup.py\",\n            \"name\": \"duplicate\",\n            \"suffixes\": [\n                \"same\"\n            ]\n        },\n        {\n            \"OTIO_SCHEMA\": \"Adapter.1\",\n            \"filepath\": \"second.py\",\n            \"name\": \"second\",\n            \"suffixes\": [\n                \"same\",\n                \"extra\"\n            ]\n        }\n    ],\n    \"hook_scripts\": [],\n    \"hooks\": {\n        \"post_adapter_read\": [\n            \"one\",\n            \"two\"\n        ],\n        \"pre_adapter_write\": [\n            \"three\"\n        ]\n    },\n    \"media_linkers\": [],\n    \"schemadefs\": [\n        {\n            \"OTIO_SCHEMA\": \"SchemaDef.1\",\n            \"filepath\": \"custom.py\",\n            \"name\": \"custom\"\n        }\n    ],\n    \"version_manifests\": {\n        \"family\": {\n            \"v1\": {\n                \"Clip\": 1\n            },\n            \"v2\": {\n                \"Clip\": 2\n            }\n        }\n    }\n}",
      ).unwrap(),
    ),
  )
}

