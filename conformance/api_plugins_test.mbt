                  Ok(
                    @otiojson.parse(
                      "{\n    \"OTIO_SCHEMA\": \"Clip.2\",\n    \"metadata\": {},\n    \"name\": \"read\",\n    \"source_range\": null,\n    \"effects\": [],\n    \"markers\": [],\n    \"enabled\": true,\n    \"color\": null,\n    \"media_references\": {\n        \"DEFAULT_MEDIA\": {\n            \"OTIO_SCHEMA\": \"MissingReference.1\",\n            \"metadata\": {},\n            \"name\": \"\",\n            \"available_range\": null,\n            \"available_image_bounds\": null\n        }\n    },\n    \"active_media_reference_key\": \"DEFAULT_MEDIA\"\n}",
                    ).unwrap(),
                  )
              }
            },
          },
          "write_to_file": {
            arguments: [],
            doc: None,
            invoke: fn(args) {
              ignore(args)
              match record("write_to_file", args, "adapter") {
                Err(e) => Err(e)
                Ok(_) => Ok(Json::string("fixture-output"))
              }
            },
          },
          "adapter_hook_names": {
            arguments: [],
            doc: None,
            invoke: fn(args) {
              ignore(args)
              Ok(Json::array([]))
            },
          },
        },
        schema_definitions: Json::empty_object(),
      })
    },
  ).unwrap()
  let services : @plugins.PluginIO = {
    read_file: fn(path) {
      match
        record(
          "file_read",
          Json::object({ "path": Json::string(path) }),
          "file",
        ) {
        Err(e) => Err(e)
        Ok(_) => Ok("fixture-input")
      }
    },
    write_file: fn(path, _text) {
      record("file_write", Json::object({ "path": Json::string(path) }), "file")
    },
    hook: fn(name, j, args) {
      match record(name, args, "hook") {
        Err(e) => return Err(e)
        _ => ()
      }
      match args {
        Object(a) =>
          match a.get("adapter_arguments") {
            Some(Object(a)) =>
              match a.get("nested") {
                Some(Object(n)) => n["keep"] = Json::number(2.0)
                _ => ()
              }
            _ => ()
          }
        _ => ()
      }
      let copy = @otiojson.clone(j).unwrap()
      match copy {
        Object(m) => {
          let old = match m.get("name") {
            Some(String(s)) => s
            _ => ""
          }
          m["name"] = Json::string(old + ":hook")
          Ok(copy)
        }
        _ => Err("invalid")
      }
    },
    link_media: fn(j, name, args) {
      match
        record(
          "link",
          Json::object({ "name": Json::string(name), "arguments": args }),
          "media",
        ) {
        Err(e) => Err(e)
        Ok(_) => Ok(j)
      }
    },
  }
  let result = plugin.write_document(
    @otiojson.parse(
      "{\n    \"OTIO_SCHEMA\": \"Clip.2\",\n    \"metadata\": {},\n    \"name\": \"write\",\n    \"source_range\": null,\n    \"effects\": [],\n    \"markers\": [],\n    \"enabled\": true,\n    \"color\": null,\n    \"media_references\": {\n        \"DEFAULT_MEDIA\": {\n            \"OTIO_SCHEMA\": \"MissingReference.1\",\n            \"metadata\": {},\n            \"name\": \"\",\n            \"available_range\": null,\n            \"available_image_bounds\": null\n        }\n    },\n    \"active_media_reference_key\": \"DEFAULT_MEDIA\"\n}",
    ).unwrap(),
    services,
    adapter_arguments=@otiojson.parse("{\"extra\":7,\"nested\":{\"keep\":1}}").unwrap(),
    hook_arguments=@otiojson.parse("{\"user\":\"keep\"}").unwrap(),
    filepath=Some("/fixture.otio"),
  )
  assert_eq(result is Ok(_), true)
  assert_true(
    @otiojson.equivalent(
      Json::array(events),
      @otiojson.parse(
        "[{\"event\":\"pre_adapter_write\",\"args\":{\"_filepath\":\"/fixture.otio\",\"adapter_arguments\":{\"extra\":7,\"nested\":{\"keep\":1}},\"user\":\"keep\"}},{\"event\":\"write_to_file\",\"args\":{\"extra\":7,\"filepath\":\"/fixture.otio\",\"hook_function_argument_map\":{\"_filepath\":\"/fixture.otio\",\"adapter_arguments\":{\"extra\":7,\"nested\":{\"keep\":2}},\"user\":\"keep\"},\"input_otio\":{\"OTIO_SCHEMA\":\"Clip.2\",\"metadata\":{},\"name\":\"write:hook\",\"source_range\":null,\"effects\":[],\"markers\":[],\"enabled\":true,\"color\":null,\"media_references\":{\"DEFAULT_MEDIA\":{\"OTIO_SCHEMA\":\"MissingReference.1\",\"metadata\":{},\"name\":\"\",\"available_range\":null,\"available_image_bounds\":null}},\"active_media_reference_key\":\"DEFAULT_MEDIA\"},\"nested\":{\"keep\":1}}},{\"event\":\"post_adapter_write\",\"args\":{\"_filepath\":\"/fixture.otio\",\"adapter_arguments\":{\"extra\":7,\"nested\":{\"keep\":2}},\"user\":\"keep\"}}]",
      ).unwrap(),
    ),
  )
  assert_true(
    @otiojson.equivalent(
      result.unwrap(),
      @otiojson.parse("\"fixture-output\"").unwrap(),
    ),
  )
}
