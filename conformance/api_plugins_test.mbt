        "[{\"event\":\"pre_adapter_write\",\"args\":{\"_filepath\":\"/fixture.otio\",\"adapter_arguments\":{\"extra\":7,\"nested\":{\"keep\":1}},\"user\":\"keep\"}},{\"event\":\"write_to_file\",\"args\":{\"extra\":7,\"filepath\":\"/fixture.otio\",\"input_otio\":{\"OTIO_SCHEMA\":\"Clip.2\",\"metadata\":{},\"name\":\"write:hook\",\"source_range\":null,\"effects\":[],\"markers\":[],\"enabled\":true,\"color\":null,\"media_references\":{\"DEFAULT_MEDIA\":{\"OTIO_SCHEMA\":\"MissingReference.1\",\"metadata\":{},\"name\":\"\",\"available_range\":null,\"available_image_bounds\":null}},\"active_media_reference_key\":\"DEFAULT_MEDIA\"},\"nested\":{\"keep\":1}}},{\"event\":\"post_adapter_write\",\"args\":{\"_filepath\":\"/fixture.otio\",\"adapter_arguments\":{\"extra\":7,\"nested\":{\"keep\":2}},\"user\":\"keep\"}}]",
      ).unwrap(),
    ),
  )
  assert_true(
