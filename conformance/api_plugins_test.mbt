              match record("write_to_file", args, "adapter") {
                Err(e) => Err(e)
                Ok(_) => Ok(Json::string("fixture-output"))
              }
            },
          },
          "adapter_hook_names": {
            arguments: [],
            doc: None,
            invoke: fn(args) {
              ignore(args)
              Ok(Json::array([]))
            },
          },
