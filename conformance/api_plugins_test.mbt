///|
test "plugins:Adapter-module-retry" {
  let calls : Array[String] = []
  let descriptor = @schema.read(
    "{\n    \"OTIO_SCHEMA\": \"Adapter.1\",\n    \"filepath\": \"/plugins/fixture.py\",\n    \"name\": \"fixture\",\n    \"suffixes\": []\n}",
  ).unwrap()
  let plugin = @plugins.Plugin::new(descriptor, fn(_description, space) {
    calls.push(space)
    if calls.length() == 1 {
      Err("ImportError:fixture")
    } else {
      Ok(@plugins.PluginModule::{
        id: "fixture",
        doc: Some("Fixture module"),
        functions: Map([]),
        schema_definitions: @otiojson.parse("{}").unwrap(),
      })
    }
  }).unwrap()
  assert_eq(plugin.load_module() is Ok(_), false)
  assert_eq(plugin.load_module() is Ok(_), true)
  assert_eq(calls, ["adapters", "adapters"])
}

