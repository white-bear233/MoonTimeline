      @otiojson.parse(
        "[{\"event\":\"read_from_string\",\"args\":{\"hook_function_argument_map\":{\"adapter_arguments\":{},\"media_linker_argument_map\":null},\"input_str\":\"fixture-input\"}}]",
      ).unwrap(),
    ),
  )
}

