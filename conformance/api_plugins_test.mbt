  let descriptor = @schema.read(
    "{\n    \"OTIO_SCHEMA\": \"Adapter.1\",\n    \"filepath\": \"/plugins/fixture.py\",\n    \"name\": \"fixture\",\n    \"suffixes\": []\n}",
  ).unwrap()
  let plugin = @plugins.Plugin::new(
    descriptor,
    fn(_description, _space) {
      Ok(@plugins.PluginModule::{
        id: "fixture",
        doc: Some("Fixture module"),
        functions: {
          "read_from_string": {
            arguments: ["input_str"],
            doc: Some("Read fixture."),
            invoke: fn(_args) { Ok(@otiojson.parse("null").unwrap()) },
          },
        },
        schema_definitions: @otiojson.parse("{}").unwrap(),
      })
    },
    manifest_path=Some("/plugins/manifest.json"),
  ).unwrap()
  assert_eq(plugin.has_feature("unknown").unwrap(), false)
}

