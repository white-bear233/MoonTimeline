///|
test "OTIO structural oracle nested_trimmed" {
  let t = review_fixture("nested_trimmed")
  let l = @timeline.layout(t).unwrap()
  near(l.duration_seconds, 3.0)
  assert_eq(l.items.length(), 1)
  assert_eq(
    l.items[0].path,
    "/tracks/children/0/children/1/children/0/children/0",
  )
  near(l.items[0].start_seconds, 0.0)
  near(l.items[0].end_seconds, 3.0)
  near(l.items[0].source_at(0.0).unwrap().to_seconds().unwrap(), 15.0)
  assert_eq(l.transitions.length(), 1)
  assert_eq(
    l.transitions[0].path,
    "/tracks/children/0/children/1/children/0/children/1",
  )
  near(l.transitions[0].start_seconds, 2.0)
  near(l.transitions[0].end_seconds, 3.5)
  near(l.transitions[0].visible_start_seconds, 2.0)
  near(l.transitions[0].visible_end_seconds, 3.0)
}
