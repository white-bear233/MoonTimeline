///|
fn near(a : Double, b : Double) -> Unit raise {
  assert_true((a - b).abs() < 0.00000001)
}

///|
test "OTIO structural oracle internal" {
  let t = review_fixture("internal")
  let l = @timeline.layout(t).unwrap()
  near(l.duration_seconds, 7.0)
  assert_eq(l.items.length(), 2)
  assert_eq(l.items[0].path, "/tracks/children/0/children/0")
  near(l.items[0].start_seconds, 0.0)
  near(l.items[0].end_seconds, 4.0)
  near(l.items[0].source_at(0.0).unwrap().to_seconds().unwrap(), 10.0)
  assert_eq(l.items[1].path, "/tracks/children/0/children/2")
  near(l.items[1].start_seconds, 4.0)
  near(l.items[1].end_seconds, 7.0)
  near(l.items[1].source_at(4.0).unwrap().to_seconds().unwrap(), 20.0)
  assert_eq(l.transitions.length(), 1)
  assert_eq(l.transitions[0].path, "/tracks/children/0/children/1")
  near(l.transitions[0].start_seconds, 3.0)
  near(l.transitions[0].end_seconds, 4.5)
  near(l.transitions[0].visible_start_seconds, 3.0)
  near(l.transitions[0].visible_end_seconds, 4.5)
}

///|
test "OTIO structural oracle leading" {
  let t = review_fixture("leading")
  let l = @timeline.layout(t).unwrap()
  near(l.duration_seconds, 4.25)
  assert_eq(l.items.length(), 1)
  assert_eq(l.items[0].path, "/tracks/children/0/children/1")
  near(l.items[0].start_seconds, 0.0)
  near(l.items[0].end_seconds, 4.0)
  near(l.items[0].source_at(0.0).unwrap().to_seconds().unwrap(), 10.0)
  assert_eq(l.transitions.length(), 1)
  assert_eq(l.transitions[0].path, "/tracks/children/0/children/0")
  near(l.transitions[0].start_seconds, -0.25)
  near(l.transitions[0].end_seconds, 0.5)
  near(l.transitions[0].visible_start_seconds, 0.0)
  near(l.transitions[0].visible_end_seconds, 0.5)
}

///|
test "OTIO structural oracle trailing" {
  let t = review_fixture("trailing")
  let l = @timeline.layout(t).unwrap()
  near(l.duration_seconds, 4.5)
  assert_eq(l.items.length(), 1)
  assert_eq(l.items[0].path, "/tracks/children/0/children/0")
  near(l.items[0].start_seconds, 0.0)
  near(l.items[0].end_seconds, 4.0)
  near(l.items[0].source_at(0.0).unwrap().to_seconds().unwrap(), 10.0)
  assert_eq(l.transitions.length(), 1)
  assert_eq(l.transitions[0].path, "/tracks/children/0/children/1")
  near(l.transitions[0].start_seconds, 3.75)
  near(l.transitions[0].end_seconds, 4.5)
  near(l.transitions[0].visible_start_seconds, 3.75)
  near(l.transitions[0].visible_end_seconds, 4.5)
}

///|
test "OTIO structural oracle both_edges" {
  let t = review_fixture("both_edges")
  let l = @timeline.layout(t).unwrap()
  near(l.duration_seconds, 4.5)
  assert_eq(l.items.length(), 1)
  assert_eq(l.items[0].path, "/tracks/children/0/children/1")
  near(l.items[0].start_seconds, 0.0)
  near(l.items[0].end_seconds, 4.0)
  near(l.items[0].source_at(0.0).unwrap().to_seconds().unwrap(), 10.0)
  assert_eq(l.transitions.length(), 2)
  assert_eq(l.transitions[0].path, "/tracks/children/0/children/0")
  near(l.transitions[0].start_seconds, -0.25)
  near(l.transitions[0].end_seconds, 0.5)
  near(l.transitions[0].visible_start_seconds, 0.0)
  near(l.transitions[0].visible_end_seconds, 0.5)
  assert_eq(l.transitions[1].path, "/tracks/children/0/children/2")
  near(l.transitions[1].start_seconds, 3.25)
  near(l.transitions[1].end_seconds, 4.25)
  near(l.transitions[1].visible_start_seconds, 3.25)
  near(l.transitions[1].visible_end_seconds, 4.25)
}

///|
test "OTIO structural oracle trimmed" {
  let t = review_fixture("trimmed")
  let l = @timeline.layout(t).unwrap()
  near(l.duration_seconds, 0.75)
  assert_eq(l.items.length(), 2)
  assert_eq(l.items[0].path, "/tracks/children/0/children/0")
  near(l.items[0].start_seconds, 0.0)
  near(l.items[0].end_seconds, 0.5)
  near(l.items[0].source_at(0.0).unwrap().to_seconds().unwrap(), 13.5)
  assert_eq(l.items[1].path, "/tracks/children/0/children/2")
  near(l.items[1].start_seconds, 0.5)
  near(l.items[1].end_seconds, 0.75)
  near(l.items[1].source_at(0.5).unwrap().to_seconds().unwrap(), 20.0)
  assert_eq(l.transitions.length(), 1)
  assert_eq(l.transitions[0].path, "/tracks/children/0/children/1")
  near(l.transitions[0].start_seconds, -0.5)
  near(l.transitions[0].end_seconds, 1.0)
  near(l.transitions[0].visible_start_seconds, 0.0)
  near(l.transitions[0].visible_end_seconds, 0.75)
}

