///|
test "official interval relations 0" {
  let a = span(0.125, 0.20833333333333334)
  let b = span(0.25, 0.16666666666666666)
  assert_eq(a.relates(b, @range.Contains), false)
  assert_eq(a.relates(b, @range.Overlaps), true)
  assert_eq(a.relates(b, @range.Before), false)
  assert_eq(a.relates(b, @range.Meets), false)
  assert_eq(a.relates(b, @range.Begins), false)
  assert_eq(a.relates(b, @range.Finishes), false)
  assert_eq(a.relates(b, @range.Intersects), true)
}

