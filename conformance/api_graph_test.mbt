test "graph:Composition-1-True-ranges" {
  let object = @schema.read(
    "{\n    \"OTIO_SCHEMA\": \"Composition.1\",\n    \"metadata\": {},\n    \"name\": \"\",\n    \"source_range\": {\n        \"OTIO_SCHEMA\": \"TimeRange.1\",\n        \"duration\": {\n            \"OTIO_SCHEMA\": \"RationalTime.1\",\n            \"rate\": 24.0,\n            \"value\": 12.0\n        },\n        \"start_time\": {\n            \"OTIO_SCHEMA\": \"RationalTime.1\",\n            \"rate\": 24.0,\n            \"value\": 6.0\n        }\n    },\n    \"effects\": [],\n    \"markers\": [],\n    \"enabled\": true,\n    \"color\": null,\n    \"children\": [\n        {\n            \"OTIO_SCHEMA\": \"Clip.2\",\n            \"metadata\": {},\n            \"name\": \"a\",\n            \"source_range\": {\n                \"OTIO_SCHEMA\": \"TimeRange.1\",\n                \"duration\": {\n                    \"OTIO_SCHEMA\": \"RationalTime.1\",\n                    \"rate\": 24.0,\n                    \"value\": 24.0\n                },\n                \"start_time\": {\n                    \"OTIO_SCHEMA\": \"RationalTime.1\",\n                    \"rate\": 24.0,\n                    \"value\": 100.0\n                }\n            },\n            \"effects\": [],\n            \"markers\": [],\n            \"enabled\": true,\n            \"color\": null,\n            \"media_references\": {\n                \"DEFAULT_MEDIA\": {\n                    \"OTIO_SCHEMA\": \"ExternalReference.1\",\n                    \"metadata\": {},\n                    \"name\": \"\",\n                    \"available_range\": {\n                        \"OTIO_SCHEMA\": \"TimeRange.1\",\n                        \"duration\": {\n                            \"OTIO_SCHEMA\": \"RationalTime.1\",\n                            \"rate\": 24.0,\n                            \"value\": 1000.0\n                        },\n                        \"start_time\": {\n                            \"OTIO_SCHEMA\": \"RationalTime.1\",\n                            \"rate\": 24.0,\n                            \"value\": 0.0\n                        }\n                    },\n                    \"available_image_bounds\": null,\n                    \"target_url\": \"a\"\n                }\n            },\n            \"active_media_reference_key\": \"DEFAULT_MEDIA\"\n        }\n    ]\n}",
  ).unwrap()
  let g = @graph.Graph::new(object)
  ignore(g)
  assert_true(g.ranges_of_all_children([]) is Err(_))
}

///|
test "graph:Composition-1-True-at--1" {
  let object = @schema.read(
    "{\n    \"OTIO_SCHEMA\": \"Composition.1\",\n    \"metadata\": {},\n    \"name\": \"\",\n    \"source_range\": {\n        \"OTIO_SCHEMA\": \"TimeRange.1\",\n        \"duration\": {\n            \"OTIO_SCHEMA\": \"RationalTime.1\",\n            \"rate\": 24.0,\n            \"value\": 12.0\n        },\n        \"start_time\": {\n            \"OTIO_SCHEMA\": \"RationalTime.1\",\n            \"rate\": 24.0,\n            \"value\": 6.0\n        }\n    },\n    \"effects\": [],\n    \"markers\": [],\n    \"enabled\": true,\n    \"color\": null,\n    \"children\": [\n        {\n            \"OTIO_SCHEMA\": \"Clip.2\",\n            \"metadata\": {},\n            \"name\": \"a\",\n            \"source_range\": {\n                \"OTIO_SCHEMA\": \"TimeRange.1\",\n                \"duration\": {\n                    \"OTIO_SCHEMA\": \"RationalTime.1\",\n                    \"rate\": 24.0,\n                    \"value\": 24.0\n                },\n                \"start_time\": {\n                    \"OTIO_SCHEMA\": \"RationalTime.1\",\n                    \"rate\": 24.0,\n                    \"value\": 100.0\n                }\n            },\n            \"effects\": [],\n            \"markers\": [],\n            \"enabled\": true,\n            \"color\": null,\n            \"media_references\": {\n                \"DEFAULT_MEDIA\": {\n                    \"OTIO_SCHEMA\": \"ExternalReference.1\",\n                    \"metadata\": {},\n                    \"name\": \"\",\n                    \"available_range\": {\n                        \"OTIO_SCHEMA\": \"TimeRange.1\",\n                        \"duration\": {\n                            \"OTIO_SCHEMA\": \"RationalTime.1\",\n                            \"rate\": 24.0,\n                            \"value\": 1000.0\n                        },\n                        \"start_time\": {\n                            \"OTIO_SCHEMA\": \"RationalTime.1\",\n                            \"rate\": 24.0,\n                            \"value\": 0.0\n                        }\n                    },\n                    \"available_image_bounds\": null,\n                    \"target_url\": \"a\"\n                }\n            },\n            \"active_media_reference_key\": \"DEFAULT_MEDIA\"\n        }\n    ]\n}",
  ).unwrap()
  let g = @graph.Graph::new(object)
  ignore(g)
  assert_true(
    g.child_at_time(
      [],
      @time.RationalTime::new(-1.0, 24.0).unwrap(),
      shallow=true,
    )
    is Err(_),
  )
}

