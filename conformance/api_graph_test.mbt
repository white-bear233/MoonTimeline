    \"start_time\": {\n                            \"OTIO_SCHEMA\": \"RationalTime.1\",\n                            \"rate\": 24.0,\n                            \"value\": 0.0\n                        }\n                    },\n                    \"available_image_bounds\": null,\n                    \"target_url\": \"a\"\n                }\n            },\n            \"active_media_reference_key\": \"DEFAULT_MEDIA\"\n        }\n    ]\n}",
  ).unwrap()
  let g = @graph.Graph::new(object)
  ignore(g)
  let result_range = g.range_in_parent([0]).unwrap().unwrap()
  let actual_time = result_range.start()
  api_number(actual_time.value(), 0.0)
  api_number(actual_time.rate(), 30.0)
  let actual_time = result_range.duration()
  api_number(actual_time.value(), 5.5)
  api_number(actual_time.rate(), 30.0)
}

