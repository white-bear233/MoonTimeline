///|
test "graph:Composition-0-True-trimmed_range" {
  let object = @schema.read(
    "{\n    \"OTIO_SCHEMA\": \"Composition.1\",\n    \"metadata\": {},\n    \"name\": \"\",\n    \"source_range\": {\n        \"OTIO_SCHEMA\": \"TimeRange.1\",\n        \"duration\": {\n            \"OTIO_SCHEMA\": \"RationalTime.1\",\n            \"rate\": 24.0,\n            \"value\": 12.0\n        },\n        \"start_time\": {\n            \"OTIO_SCHEMA\": \"RationalTime.1\",\n            \"rate\": 24.0,\n            \"value\": 6.0\n        }\n    },\n    \"effects\": [],\n    \"markers\": [],\n    \"enabled\": true,\n    \"color\": null,\n    \"children\": []\n}",
  ).unwrap()
  let g = @graph.Graph::new(object)
  ignore(g)
  let result_range = @graph.trimmed_range(object).unwrap()
  let actual_time = result_range.start()
  api_number(actual_time.value(), 6.0)
  api_number(actual_time.rate(), 24.0)
  let actual_time = result_range.duration()
  api_number(actual_time.value(), 12.0)
  api_number(actual_time.rate(), 24.0)
}

