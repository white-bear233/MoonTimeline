    "{\n    \"OTIO_SCHEMA\": \"Track.1\",\n    \"metadata\": {},\n    \"name\": \"\",\n    \"source_range\": {\n        \"OTIO_SCHEMA\": \"TimeRange.1\",\n        \"duration\": {\n            \"OTIO_SCHEMA\": \"RationalTime.1\",\n            \"rate\": 24.0,\n            \"value\": 12.0\n        },\n        \"start_time\": {\n            \"OTIO_SCHEMA\": \"RationalTime.1\",\n            \"rate\": 24.0,\n            \"value\": 6.0\n        }\n    },\n    \"effects\": [],\n    \"markers\": [],\n    \"enabled\": true,\n    \"color\": null,\n    \"children\": [\n        {\n            \"OTIO_SCHEMA\": \"Clip.2\",\n            \"metadata\": {},\n            \"name\": \"\",\n            \"source_range\": null,\n            \"effects\": [],\n            \"markers\": [],\n            \"enabled\": true,\n            \"color\": null,\n            \"media_references\": {\n                \"DEFAULT_MEDIA\": {\n                    \"OTIO_SCHEMA\": \"MissingReference.1\",\n                    \"metadata\": {},\n                    \"name\": \"\",\n                    \"available_range\": null,\n                    \"available_image_bounds\": null\n                }\n            },\n            \"active_media_reference_key\": \"DEFAULT_MEDIA\"\n        }\n    ],\n    \"kind\": \"Video\"\n}",
  ).unwrap()
  let g = @graph.Graph::new(object)
  ignore(g)
  assert_true(
    g.child_at_time(
      [],
      @time.RationalTime::new(48.0, 24.0).unwrap(),
      shallow=true,
    )
    is Err(_),
  )
}

