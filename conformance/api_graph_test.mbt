_SCHEMA\": \"RationalTime.1\",\n                            \"rate\": 24.0,\n                            \"value\": 36.0\n                        },\n                        \"start_time\": {\n                            \"OTIO_SCHEMA\": \"RationalTime.1\",\n                            \"rate\": 24.0,\n                            \"value\": 3.0\n                        }\n                    },\n                    \"effects\": [],\n                    \"markers\": [],\n                    \"enabled\": true,\n                    \"color\": null,\n                    \"children\": [\n                        {\n                            \"OTIO_SCHEMA\": \"Gap.1\",\n                            \"metadata\": {},\n                            \"name\": \"\",\n                            \"source_range\": {\n                                \"OTIO_SCHEMA\": \"TimeRange.1\",\n                                \"duration\": {\n                                    \"OTIO_SCHEMA\": \"RationalTime.1\",\n                                    \"rate\": 30.0,\n                                    \"value\": 15.0\n                                },\n                                \"start_time\": {\n                                    \"OTIO_SCHEMA\": \"RationalTime.1\",\n                                    \"rate\": 30.0,\n                                    \"value\": 0.0\n                                }\n                            },\n                            \"effects\": [],\n                            \"markers\": [],\n                            \"enabled\": true,\n                            \"color\": null\n                        },\n                        {\n                            \"OTIO_SCHEMA\": \"Clip.2\",\n                            \"metadata\": {},\n                            \"name\": \"nested\",\n                            \"source_range\": {\n                                \"OTIO_SCHEMA\": \"TimeRange.1\",\n                                \"duration\"