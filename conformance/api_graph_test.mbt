test "graph:nested-[]-[]-range_of_child" {
  let g = @graph.Graph::new(
    @schema.read(
      "{\n    \"OTIO_SCHEMA\": \"Track.1\",\n    \"metadata\": {},\n    \"name\": \"\",\n    \"source_range\": null,\n    \"effects\": [],\n    \"markers\": [],\n    \"enabled\": true,\n    \"color\": null,\n    \"children\": [\n        {\n            \"OTIO_SCHEMA\": \"Gap.1\",\n            \"metadata\": {},\n            \"name\": \"\",\n            \"source_range\": {\n                \"OTIO_SCHEMA\": \"TimeRange.1\",\n                \"duration\": {\n                    \"OTIO_SCHEMA\": \"RationalTime.1\",\n                    \"rate\": 48.0,\n                    \"value\": 24.0\n                },\n                \"start_time\": {\n                    \"OTIO_SCHEMA\": \"RationalTime.1\",\n                    \"rate\": 48.0,\n                    \"value\": 0.0\n                }\n            },\n            \"effects\": [],\n            \"markers\": [],\n            \"enabled\": true,\n            \"color\": null\n        },\n        {\n            \"OTIO_SCHEMA\": \"Stack.1\",\n            \"metadata\": {},\n            \"name\": \"\",\n            \"source_range\": {\n                \"OTIO_SCHEMA\": \"TimeRange.1\",\n                \"duration\": {\n                    \"OTIO_SCHEMA\": \"RationalTime.1\",\n                    \"rate\": 30.0,\n                    \"value\": 30.0\n                },\n                \"start_time\": {\n                    \"OTIO_SCHEMA\": \"RationalTime.1\",\n                    \"rate\": 30.0,\n                    \"value\": 6.0\n                }\n            },\n            \"effects\": [],\n            \"markers\": [],\n            \"enabled\": true,\n            \"color\": null,\n            \"children\": [\n                {\n                    \"OTIO_SCHEMA\": \"Track.1\",\n                    \"metadata\": {},\n                    \"name\": \"\",\n                    \"source_range\": {\n                        \"OTIO_SCHEMA\": \"TimeRange.1\",\n                        \"duration\": {\n                            \"OTIO_SCHEMA\": \"RationalTime.1\",\n                            \"rate\": 24.0,\n                            \"value\": 36.0\n                        },\n                        \"start_time\": {\n                            \"OTIO_SCHEMA\": \"RationalTime.1\",\n                            \"rate\": 24.0,\n                            \"value\": 3.0\n                        }\n                    },\n                    \"effects\": [],\n                    \"markers\": [],\n                    \"enabled\": true,\n                    \"color\": null,\n                    \"children\": [\n                        {\n                            \"OTIO_SCHEMA\": \"Gap.1\",\n                            \"metadata\": {},\n                            \"name\": \"\",\n                            \"source_range\": {\n                                \"OTIO_SCHEMA\": \"TimeRange.1\",\n                                \"duration\": {\n                                    \"OTIO_SCHEMA\": \"RationalTime.1\",\n                                    \"rate\": 30.0,\n                                    \"value\": 15.0\n                                },\n                                \"start_time\": {\n                                    \"OTIO_SCHEMA\": \"RationalTime.1\",\n                                    \"rate\": 30.0,\n                                    \"value\": 0.0\n                                }\n                            },\n                            \"effects\": [],\n                            \"markers\": [],\n                            \"enabled\": true,\n                            \"color\": null\n                        },\n                        {\n                            \"OTIO_SCHEMA\": \"Clip.2\",\n                            \"metadata\": {},\n                            \"name\": \"nested\",\n                            \"source_range\": {\n                                \"OTIO_SCHEMA\": \"TimeRange.1\",\n                                \"duration\": {\n                                    \"OTIO_SCHEMA\": \"RationalTime.1\",\n                                    \"rate\": 24.0,\n                                    \"value\": 48.0\n                                },\n                                \"start_time\": {\n                                    \"OTIO_SCHEMA\": \"RationalTime.1\",\n                                    \"rate\": 24.0,\n                                    \"value\": 100.0\n                                }\n                            },\n                            \"effects\": [],\n                            \"markers\": [],\n                            \"enabled\": true,\n                            \"color\": null,\n                            \"media_references\": {\n                                \"DEFAULT_MEDIA\": {\n                                    \"OTIO_SCHEMA\": \"MissingReference.1\",\n                                    \"metadata\": {},\n                                    \"name\": \"\",\n                                    \"available_range\": null,\n                                    \"available_image_bounds\": null\n                                }\n                            },\n                            \"active_media_reference_key\": \"DEFAULT_MEDIA\"\n                        }\n                    ],\n                    \"kind\": \"Video\"\n                }\n            ]\n        }\n    ],\n    \"kind\": \"Video\"\n}",
    ).unwrap(),
  )
  assert_true(g.range_of_descendant([], [], trimmed=false) is Err(_))
}

