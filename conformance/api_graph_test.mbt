: {\n                                    \"OTIO_SCHEMA\": \"RationalTime.1\",\n                                    \"rate\": 24.0,\n                                    \"value\": 48.0\n                                },\n                                \"start_time\": {\n                                    \"OTIO_SCHEMA\": \"RationalTime.1\",\n                                    \"rate\": 24.0,\n                                    \"value\": 100.0\n                                }\n                            },\n                            \"effects\": [],\n                            \"markers\": [],\n                            \"enabled\": true,\n                            \"color\": null,\n                            \"media_references\": {\n                                \"DEFAULT_MEDIA\": {\n                                    \"OTIO_SCHEMA\": \"MissingReference.1\",\n                                    \"metadata\": {},\n                                    \"name\": \"\",\n                                    \"available_range\": null,\n                                    \"available_image_bounds\": null\n                                }\n                            },\n                            \"active_media_reference_key\": \"DEFAULT_MEDIA\"\n                        }\n                    ],\n                    \"kind\": \"Video\"\n                }\n            ]\n        }\n    ],\n    \"kind\": \"Video\"\n}",
    ).unwrap(),
  )
  let result_range = g
    .transformed_range(
      @range.TimeRange::new(
        @time.RationalTime::new(48.0, 24.0).unwrap(),
        @time.RationalTime::new(12.0, 24.0).unwrap(),
      ).unwrap(),
      [],
      [],
    )
    .unwrap()
  let actual_time = result_range.start()
  api_number(actual_time.value(), 48.0)
  api_number(actual_time.rate(), 24.0)
  let actual_time = result_range.duration()
  api_number(actual_time.value(), 12.0)
  api_number(actual_time.rate(), 24.0)
}

///|
test "graph:nested-[]-[1]-range_of_child" {
