value\": 0.0\n                        }\n                    },\n                    \"available_image_bounds\": null,\n                    \"target_url\": \"a\"\n                }\n            },\n            \"active_media_reference_key\": \"DEFAULT_MEDIA\"\n        },\n        {\n            \"OTIO_SCHEMA\": \"Transition.1\",\n            \"metadata\": {},\n            \"name\": \"\",\n            \"in_offset\": {\n                \"OTIO_SCHEMA\": \"RationalTime.1\",\n                \"rate\": 24.0,\n                \"value\": 2.0\n            },\n            \"out_offset\": {\n                \"OTIO_SCHEMA\": \"RationalTime.1\",\n                \"rate\": 30.0,\n                \"value\": 3.0\n            },\n            \"transition_type\": \"\"\n        }\n    ],\n    \"kind\": \"Video\"\n}",
  ).unwrap()
  let g = @graph.Graph::new(object)
  ignore(g)
  let (left, right) = g.neighbors([0], insert_gaps=false).unwrap()
  assert_true(left is None)
