///|
test "graph:Stack-5-False-range-0-1" {
  let object = @schema.read(
    "{\n    \"OTIO_SCHEMA\": \"Stack.1\",\n    \"metadata\": {},\n    \"name\": \"\",\n    \"source_range\": null,\n    \"effects\": [],\n    \"markers\": [],\n    \"enabled\": true,\n    \"color\": null,\n    \"children\": [\n        {\n            \"OTIO_SCHEMA\": \"Clip.2\",\n            \"metadata\": {},\n            \"name\": \"a\",\n            \"source_range\": {\n                \"OTIO_SCHEMA\": \"TimeRange.1\",\n                \"duration\": {\n                    \"OTIO_SCHEMA\": \"RationalTime.1\",\n                    \"rate\": 24.0,\n                    \"value\": 24.0\n                },\n                \"start_time\": {\n                    \"OTIO_SCHEMA\": \"RationalTime.1\",\n                    \"rate\": 24.0,\n                    \"value\": 100.0\n                }\n            },\n            \"effects\": [],\n            \"markers\": [],\n            \"enabled\": true,\n            \"color\": null,\n            \"media_references\": {\n                \"DEFAULT_MEDIA\": {\n                    \"OTIO_SCHEMA\": \"ExternalReference.1\",\n                    \"metadata\": {},\n                    \"name\": \"\",\n                    \"available_range\": {\n                        \"OTIO_SCHEMA\": \"TimeRange.1\",\n                        \"duration\": {\n                            \"OTIO_SCHEMA\": \"RationalTime.1\",\n                            \"rate\": 24.0,\n                            \"value\": 1000.0\n                        },\n                        \"start_time\": {\n                            \"OTIO_SCHEMA\": \"RationalTime.1\",\n                            \"rate\": 24.0,\n                            \"value\": 0.0\n                        }\n                    },\n                    \"available_image_bounds\": null,\n                    \"target_url\": \"a\"\n                }\n            },\n            \"active_media_reference_key\": \"DEFAULT_MEDIA\"\n        },\n        {\n            \"OTIO_SCHEMA\": \"Transition.1\",\n            \"metadata\": {},\n            \"name\": \"\",\n            \"in_offset\": {\n                \"OTIO_SCHEMA\": \"RationalTime.1\",\n                \"rate\": 24.0,\n                \"value\": 2.0\n            },\n            \"out_offset\": {\n                \"OTIO_SCHEMA\": \"RationalTime.1\",\n                \"rate\": 30.0,\n                \"value\": 3.0\n            },\n            \"transition_type\": \"\"\n        }\n    ]\n}",
  ).unwrap()
  let g = @graph.Graph::new(object)
  ignore(g)
  assert_eq(
    g
    .children_in_range(
      [],
      @range.TimeRange::new(
        @time.RationalTime::new(0.0, 24.0).unwrap(),
        @time.RationalTime::new(1.0, 24.0).unwrap(),
      ).unwrap(),
    )
    .unwrap(),
    [[0]],
  )
}

