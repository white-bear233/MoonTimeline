///|
test "graph:Stack-4-True-ranges" {
  let object = @schema.read(
    "{\n    \"OTIO_SCHEMA\": \"Stack.1\",\n    \"metadata\": {},\n    \"name\": \"\",\n    \"source_range\": {\n        \"OTIO_SCHEMA\": \"TimeRange.1\",\n        \"duration\": {\n            \"OTIO_SCHEMA\": \"RationalTime.1\",\n            \"rate\": 24.0,\n            \"value\": 12.0\n        },\n        \"start_time\": {\n            \"OTIO_SCHEMA\": \"RationalTime.1\",\n            \"rate\": 24.0,\n            \"value\": 6.0\n        }\n    },\n    \"effects\": [],\n    \"markers\": [],\n    \"enabled\": true,\n    \"color\": null,\n    \"children\": [\n        {\n            \"OTIO_SCHEMA\": \"Transition.1\",\n            \"metadata\": {},\n            \"name\": \"\",\n            \"in_offset\": {\n                \"OTIO_SCHEMA\": \"RationalTime.1\",\n                \"rate\": 24.0,\n                \"value\": 2.0\n            },\n            \"out_offset\": {\n                \"OTIO_SCHEMA\": \"RationalTime.1\",\n                \"rate\": 30.0,\n                \"value\": 3.0\n            },\n            \"transition_type\": \"\"\n        },\n        {\n            \"OTIO_SCHEMA\": \"Clip.2\",\n            \"metadata\": {},\n            \"name\": \"a\",\n            \"source_range\": {\n                \"OTIO_SCHEMA\": \"TimeRange.1\",\n                \"duration\": {\n                    \"OTIO_SCHEMA\": \"RationalTime.1\",\n                    \"rate\": 24.0,\n                    \"value\": 24.0\n                },\n                \"start_time\": {\n                    \"OTIO_SCHEMA\": \"RationalTime.1\",\n                    \"rate\": 24.0,\n                    \"value\": 100.0\n                }\n            },\n            \"effects\": [],\n            \"markers\": [],\n            \"enabled\": true,\n            \"color\": null,\n            \"media_references\": {\n                \"DEFAULT_MEDIA\": {\n                    \"OTIO_SCHEMA\": \"ExternalReference.1\",\n                    \"metadata\": {},\n                    \"name\": \"\",\n                    \"available_range\": {\n                        \"OTIO_SCHEMA\": \"TimeRange.1\",\n                        \"duration\": {\n                            \"OTIO_SCHEMA\": \"RationalTime.1\",\n                            \"rate\": 24.0,\n                            \"value\": 1000.0\n                        },\n                        \"start_time\": {\n                            \"OTIO_SCHEMA\": \"RationalTime.1\",\n                            \"rate\": 24.0,\n                            \"value\": 0.0\n                        }\n                    },\n                    \"available_image_bounds\": null,\n                    \"target_url\": \"a\"\n                }\n            },\n            \"active_media_reference_key\": \"DEFAULT_MEDIA\"\n        }\n    ]\n}",
  ).unwrap()
  let g = @graph.Graph::new(object)
  ignore(g)
  let ranges = g.ranges_of_all_children([]).unwrap()
  assert_eq(ranges.length(), 2)
  let result_range = ranges[0].unwrap()
  let actual_time = result_range.start()
  api_number(actual_time.value(), 0.0)
  api_number(actual_time.rate(), 30.0)
  let actual_time = result_range.duration()
  api_number(actual_time.value(), 5.5)
  api_number(actual_time.rate(), 30.0)
  let result_range = ranges[1].unwrap()
  let actual_time = result_range.start()
  api_number(actual_time.value(), 0.0)
  api_number(actual_time.rate(), 24.0)
  let actual_time = result_range.duration()
  api_number(actual_time.value(), 24.0)
  api_number(actual_time.rate(), 24.0)
}

