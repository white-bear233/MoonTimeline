    "{\n    \"OTIO_SCHEMA\": \"Stack.1\",\n    \"metadata\": {},\n    \"name\": \"\",\n    \"source_range\": null,\n    \"effects\": [],\n    \"markers\": [],\n    \"enabled\": true,\n    \"color\": null,\n    \"children\": []\n}",
  ).unwrap()
  let g = @graph.Graph::new(object)
  ignore(g)
  assert_eq(
    g
    .children_in_range(
      [],
      @range.TimeRange::new(
        @time.RationalTime::new(23.0, 24.0).unwrap(),
        @time.RationalTime::new(12.0, 24.0).unwrap(),
      ).unwrap(),
    )
    .unwrap(),
    [],
  )
}

