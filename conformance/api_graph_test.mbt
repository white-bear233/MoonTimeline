    "{\n    \"OTIO_SCHEMA\": \"Stack.1\",\n    \"metadata\": {},\n    \"name\": \"\",\n    \"source_range\": {\n        \"OTIO_SCHEMA\": \"TimeRange.1\",\n        \"duration\": {\n            \"OTIO_SCHEMA\": \"RationalTime.1\",\n            \"rate\": 24.0,\n            \"value\": 12.0\n        },\n        \"start_time\": {\n            \"OTIO_SCHEMA\": \"RationalTime.1\",\n            \"rate\": 24.0,\n            \"value\": 6.0\n        }\n    },\n    \"effects\": [],\n    \"markers\": [],\n    \"enabled\": true,\n    \"color\": null,\n    \"children\": []\n}",
  ).unwrap()
  let g = @graph.Graph::new(object)
  ignore(g)
  assert_eq(
    g
    .children_in_range(
      [],
      @range.TimeRange::new(
        @time.RationalTime::new(25.0, 24.0).unwrap(),
        @time.RationalTime::new(1.0, 24.0).unwrap(),
      ).unwrap(),
    )
    .unwrap(),
    [],
  )
}

