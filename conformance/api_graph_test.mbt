_SCHEMA\": \"RationalTime.1\",\n                            \"rate\": 24.0,\n                            \"value\": 36.0\n                        },\n                        \"start_time\": {\n                            \"OTIO_SCHEMA\": \"RationalTime.1\",\n                            \"rate\": 24.0,\n                            \"value\": 3.0\n                        }\n                    },\n                    \"effects\": [],\n                    \"markers\": [],\n                    \"enabled\": true,\n                    \"color\": null,\n                    \"children\": [\n                        {\n                            \"OTIO_SCHEMA\": \"Gap.1\",\n                            \"metadata\": {},\n                            \"name\": \"\",\n                            \"source_range\": {\n                                \"OTIO_SCHEMA\": \"TimeRange.1\",\n                                \"duration\": {\n                                    \"OTIO_SCHEMA\": \"RationalTime.1\",\n                                    \"rate\": 30.0,\n                                    \"value\": 15.0\n                                },\n                                \"start_time\": {\n                                    \"OTIO_SCHEMA\": \"RationalTime.1\",\n                                    \"rate\": 30.0,\n                                    \"value\": 0.0\n                                }\n                            },\n                            \"effects\": [],\n                            \"markers\": [],\n                            \"enabled\": true,\n                            \"color\": null\n                        },\n                        {\n                            \"OTIO_SCHEMA\": \"Clip.2\",\n                            \"metadata\": {},\n                            \"name\": \"nested\",\n                            \"source_range\": {\n                                \"OTIO_SCHEMA\": \"TimeRange.1\",\n                                \"duration\": {\n                                    \"OTIO_SCHEMA\": \"RationalTime.1\",\n                                    \"rate\": 24.0,\n                                    \"value\": 48.0\n                                },\n                                \"start_time\": {\n                                    \"OTIO_SCHEMA\": \"RationalTime.1\",\n                                    \"rate\": 24.0,\n                                    \"value\": 100.0\n                                }\n                            },\n                            \"effects\": [],\n                            \"markers\": [],\n                            \"enabled\": true,\n                            \"color\": null,\n                            \"media_references\": {\n                                \"DEFAULT_MEDIA\": {\n                                    \"OTIO_SCHEMA\": \"MissingReference.1\",\n                                    \"metadata\": {},\n                                    \"name\": \"\",\n                                    \"available_range\": null,\n                                    \"available_image_bounds\": null\n                                }\n                            },\n                            \"active_media_reference_key\": \"DEFAULT_MEDIA\"\n                        }\n                    ],\n                    \"kind\": \"Video\"\n                }\n            ]\n        }\n    ],\n    \"kind\": \"Video\"\n}",
    ).unwrap(),
  )
  let result_range = g
    .transformed_range(
      @range.TimeRange::new(
        @time.RationalTime::new(48.0, 24.0).unwrap(),
        @time.RationalTime::new(12.0, 24.0).unwrap(),
      ).unwrap(),
      [],
      [1],
    )
    .unwrap()
  let actual_time = result_range.start()
  api_number(actual_time.value(), 81.6)
  api_number(actual_time.rate(), 48.0)
  let actual_time = result_range.duration()
  api_number(actual_time.value(), 12.0)
  api_number(actual_time.rate(), 24.0)
}

