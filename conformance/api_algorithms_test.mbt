        "{\n    \"OTIO_SCHEMA\": \"Gap.1\",\n    \"metadata\": {},\n    \"name\": \"_transition_pre\",\n    \"source_range\": {\n        \"OTIO_SCHEMA\": \"TimeRange.1\",\n        \"duration\": {\n            \"OTIO_SCHEMA\": \"RationalTime.1\",\n            \"rate\": 24.0,\n            \"value\": 3.6\n        },\n        \"start_time\": {\n            \"OTIO_SCHEMA\": \"RationalTime.1\",\n            \"rate\": 24.0,\n            \"value\": 0.0\n        }\n    },\n    \"effects\": [],\n    \"markers\": [],\n    \"enabled\": true,\n    \"color\": null\n}",
      ).unwrap(),
    ),
  )
  assert_true(
    t.equivalent(
      @schema.read(
        "{\n    \"OTIO_SCHEMA\": \"Transition.1\",\n    \"metadata\": {},\n    \"name\": \"\",\n    \"in_offset\": {\n        \"OTIO_SCHEMA\": \"RationalTime.1\",\n        \"rate\": 24.0,\n        \"value\": 2.0\n    },\n    \"out_offset\": {\n        \"OTIO_SCHEMA\": \"RationalTime.1\",\n        \"rate\": 30.0,\n        \"value\": 2.0\n    },\n    \"transition_type\": \"\"\n}",
      ).unwrap(),
    ),
