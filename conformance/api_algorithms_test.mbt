    ).unwrap(),
    fn(_previous, node, _next) {
      Ok([node.with_name(node.name().unwrap() + ":visited").unwrap()])
    },
    prune=["Track"],
  ).unwrap()
  assert_true(
    result[0].equivalent(
      @schema.read(
        "{\n    \"OTIO_SCHEMA\": \"Timeline.1\",\n    \"metadata\": {},\n    \"name\": \":visited\",\n    \"global_start_time\": null,\n    \"tracks\": {\n        \"OTIO_SCHEMA\": \"Stack.1\",\n        \"metadata\": {},\n        \"name\": \"tracks:visited\",\n        \"source_range\": null,\n        \"effects\": [],\n        \"markers\": [],\n        \"enabled\": true,\n        \"color\": null,\n        \"children\": []\n    }\n}",
      ).unwrap(),
    ),
  )
}

