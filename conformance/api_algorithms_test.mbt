        "{\n    \"OTIO_SCHEMA\": \"Gap.1\",\n    \"metadata\": {},\n    \"name\": \"_transition_post\",\n    \"source_range\": {\n        \"OTIO_SCHEMA\": \"TimeRange.1\",\n        \"duration\": {\n            \"OTIO_SCHEMA\": \"RationalTime.1\",\n            \"rate\": 30.0,\n            \"value\": 4.5\n        },\n        \"start_time\": {\n            \"OTIO_SCHEMA\": \"RationalTime.1\",\n            \"rate\": 30.0,\n            \"value\": -2.5\n        }\n    },\n    \"effects\": [],\n    \"markers\": [],\n    \"enabled\": true,\n    \"color\": null\n}",
      ).unwrap(),
    ),
  )
}

///|
test "algorithms:expand-only-30" {
  let items = @algorithms.track_with_expanded_transitions(
    @schema.read(
      "{\n    \"OTIO_SCHEMA\": \"Track.1\",\n    \"metadata\": {},\n    \"name\": \"\",\n    \"source_range\": null,\n    \"effects\": [],\n    \"markers\": [],\n    \"enabled\": true,\n    \"color\": null,\n    \"children\": [\n        {\n            \"OTIO_SCHEMA\": \"Transition.1\",\n            \"metadata\": {},\n            \"name\": \"\",\n            \"in_offset\": {\n                \"OTIO_SCHEMA\": \"RationalTime.1\",\n                \"rate\": 24.0,\n                \"value\": 30.0\n            },\n            \"out_offset\": {\n                \"OTIO_SCHEMA\": \"RationalTime.1\",\n                \"rate\": 30.0,\n                \"value\": 30.0\n            },\n            \"transition_type\": \"\"\n        }\n    ],\n    \"kind\": \"Video\"\n}",
    ).unwrap(),
  ).unwrap()
  assert_eq(items.length(), 1)
  let (a, t, b) = match items[0] {
    @algorithms.Transition(a, t, b) => (a, t, b)
    _ => fail("expected transition")
  }
  assert_true(
    a.equivalent(
      @schema.read(
        "{\n    \"OTIO_SCHEMA\": \"Gap.1\",\n    \"metadata\": {},\n    \"name\": \"_transition_pre\",\n    \"source_range\": {\n        \"OTIO_SCHEMA\": \"TimeRange.1\",\n        \"duration\": {\n            \"OTIO_SCHEMA\": \"RationalTime.1\",\n            \"rate\": 24.0,\n            \"value\": 54.0\n        },\n        \"start_time\": {\n            \"OTIO_SCHEMA\": \"RationalTime.1\",\n            \"rate\": 24.0,\n            \"value\": 0.0\n        }\n    },\n    \"effects\": [],\n    \"markers\": [],\n    \"enabled\": true,\n    \"color\": null\n}",
      ).unwrap(),
    ),
  )
  assert_true(
    t.equivalent(
      @schema.read(
        "{\n    \"OTIO_SCHEMA\": \"Transition.1\",\n    \"metadata\": {},\n    \"name\": \"\",\n    \"in_offset\": {\n        \"OTIO_SCHEMA\": \"RationalTime.1\",\n        \"rate\": 24.0,\n        \"value\": 30.0\n    },\n    \"out_offset\": {\n        \"OTIO_SCHEMA\": \"RationalTime.1\",\n        \"rate\": 30.0,\n        \"value\": 30.0\n    },\n    \"transition_type\": \"\"\n}",
      ).unwrap(),
    ),
  )
  assert_true(
    b.equivalent(
      @schema.read(
        "{\n    \"OTIO_SCHEMA\": \"Gap.1\",\n    \"metadata\": {},\n    \"name\": \"_transition_post\",\n    \"source_range\": {\n        \"OTIO_SCHEMA\": \"TimeRange.1\",\n        \"duration\": {\n            \"OTIO_SCHEMA\": \"RationalTime.1\",\n            \"rate\": 30.0,\n            \"value\": 67.5\n        },\n        \"start_time\": {\n            \"OTIO_SCHEMA\": \"RationalTime.1\",\n            \"rate\": 30.0,\n            \"value\": -37.5\n        }\n    },\n    \"effects\": [],\n    \"markers\": [],\n    \"enabled\": true,\n    \"color\": null\n}",
      ).unwrap(),
    ),
  )
}

