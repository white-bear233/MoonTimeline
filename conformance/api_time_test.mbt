test "time:3" {
  let t = @opentime.RationalTime::new(value=-30.5, rate=24.0)
  assert_eq(t.is_valid_time(), true)
  assert_eq(t.is_invalid_time(), false)
  api_number(t.to_seconds(), -1.2708333333333333)
  let actual = t.floor()
  api_number(actual.value, -31.0)
  api_number(actual.rate, 24.0)
  let actual = t.ceil()
  api_number(actual.value, -30.0)
  api_number(actual.rate, 24.0)
  let actual = t.round()
  api_number(actual.value, -31.0)
  api_number(actual.rate, 24.0)
  let actual = t.rescaled_to(-1.0)
  api_number(actual.value, 1.2708333333333333)
  api_number(actual.rate, -1.0)
