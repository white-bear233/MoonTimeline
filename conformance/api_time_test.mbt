  api_number(actual.value, 1.0 / 0.0)
  api_number(actual.rate, 24.0)
  api_number(t.value_rescaled_to(24.0), 1.0 / 0.0)
  let actual = t.rescaled_to(30.0)
  api_number(actual.value, 1.0 / 0.0)
  api_number(actual.rate, 30.0)
  api_number(t.value_rescaled_to(30.0), 1.0 / 0.0)
  let actual = t.rescaled_to(23.976023976023978)
