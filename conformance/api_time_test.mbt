  let actual = @opentime.from_seconds(1.9, rate=24.0)
  api_number(actual.value, 45.599999999999994)
  api_number(actual.rate, 24.0)
  assert_eq(
    @opentime.RationalTime::new(value=1.9, rate=24.0).to_frames().unwrap(),
    1,
  )
}

///|
test "time:frames-4-30" {
  let actual = @opentime.from_frames(1.9, 30.0).unwrap()
  api_number(actual.value, 1.0)
  api_number(actual.rate, 30.0)
  let actual = @opentime.from_seconds(1.9, rate=30.0)
  api_number(actual.value, 57.0)
  api_number(actual.rate, 30.0)
  assert_eq(
    @opentime.RationalTime::new(value=1.9, rate=30.0).to_frames().unwrap(),
    1,
  )
}

