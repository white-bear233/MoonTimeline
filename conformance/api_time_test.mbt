  let actual = t.rescaled_to(0.0)
  api_number(actual.value, -0.0)
  api_number(actual.rate, 0.0)
  api_number(t.value_rescaled_to(0.0), -0.0)
  let actual = t.rescaled_to(1.0)
  api_number(actual.value, -1.2708333333333333)
  api_number(actual.rate, 1.0)
  api_number(t.value_rescaled_to(1.0), -1.2708333333333333)
  let actual = t.rescaled_to(24.0)
  api_number(actual.value, -30.5)
  api_number(actual.rate, 24.0)
  api_number(t.value_rescaled_to(24.0), -30.5)
  let actual = t.rescaled_to(30.0)
  api_number(actual.value, -38.125)
  api_number(actual.rate, 30.0)
  api_number(t.value_rescaled_to(30.0), -38.125)
