  api_number(actual.rate, 0.0)
  api_number(t.value_rescaled_to(0.0), 0.0)
  let actual = t.rescaled_to(1.0)
  api_number(actual.value, 0.0)
  api_number(actual.rate, 1.0)
  api_number(t.value_rescaled_to(1.0), 0.0)
  let actual = t.rescaled_to(24.0)
  api_number(actual.value, 0.0)
  api_number(actual.rate, 24.0)
  api_number(t.value_rescaled_to(24.0), 0.0)
  let actual = t.rescaled_to(30.0)
  api_number(actual.value, 0.0)
  api_number(actual.rate, 30.0)
  api_number(t.value_rescaled_to(30.0), 0.0)
  let actual = t.rescaled_to(23.976023976023978)
  api_number(actual.value, 0.0)
  api_number(actual.rate, 23.976023976023978)
  api_number(t.value_rescaled_to(23.976023976023978), 0.0)
  let actual = t.rescaled_to(1.0 / 0.0)
  api_number(actual.value, 0.0 / 0.0)
  api_number(actual.rate, 1.0 / 0.0)
  api_number(t.value_rescaled_to(1.0 / 0.0), 0.0 / 0.0)
  let actual = t.rescaled_to(0.0 / 0.0)
  api_number(actual.value, 0.0 / 0.0)
  api_number(actual.rate, 0.0 / 0.0)
  api_number(t.value_rescaled_to(0.0 / 0.0), 0.0 / 0.0)
  let other = @opentime.RationalTime::new(value=50.0, rate=48.0)
  assert_eq(t.almost_equal(other, delta=-1.0), false)
  assert_eq(t.almost_equal(other, delta=0.0), false)
  assert_eq(t.almost_equal(other, delta=1.0), false)
  assert_eq(t.almost_equal(other, delta=1.0 / 0.0), true)
  assert_eq(t.almost_equal(other, delta=0.0 / 0.0), false)
  assert_eq(t.strictly_equal(other), false)
  assert_eq(t.equals(other), false)
  assert_eq(t.greater(other), false)
  assert_eq(t.greater_equal(other), false)
  assert_eq(t.less(other), true)
  assert_eq(t.less_equal(other), true)
  let actual = t.add(other)
  api_number(actual.value, 50.0)
  api_number(actual.rate, 48.0)
  let actual = t.subtract(other)
  api_number(actual.value, -50.0)
  api_number(actual.rate, 48.0)
  let actual = @opentime.duration_from_start_end_time(t, other, inclusive=false)
  api_number(actual.value, -1.0416666666666667)
  api_number(actual.rate, -1.0)
  let actual = @opentime.duration_from_start_end_time(t, other, inclusive=true)
  api_number(actual.value, -0.04166666666666674)
  api_number(actual.rate, -1.0)
  let other = @opentime.RationalTime::new(value=0.0, rate=0.0)
  assert_eq(t.almost_equal(other, delta=-1.0), false)
  assert_eq(t.almost_equal(other, delta=0.0), true)
  assert_eq(t.almost_equal(other, delta=1.0), true)
  assert_eq(t.almost_equal(other, delta=1.0 / 0.0), true)
  assert_eq(t.almost_equal(other, delta=0.0 / 0.0), false)
  assert_eq(t.strictly_equal(other), false)
  assert_eq(t.equals(other), true)
  assert_eq(t.greater(other), false)
  assert_eq(t.greater_equal(other), false)
  assert_eq(t.less(other), true)
  assert_eq(t.less_equal(other), true)
  let actual = t.add(other)
  api_number(actual.value, 0.0)
  api_number(actual.rate, 0.0)
  let actual = t.subtract(other)
  api_number(actual.value, 0.0)
  api_number(actual.rate, 0.0)
  let actual = @opentime.duration_from_start_end_time(t, other, inclusive=false)
  api_number(actual.value, 0.0 / 0.0)
  api_number(actual.rate, -1.0)
  let actual = @opentime.duration_from_start_end_time(t, other, inclusive=true)
  api_number(actual.value, 0.0 / 0.0)
  api_number(actual.rate, -1.0)
  let other = @opentime.RationalTime::new(value=1.0, rate=0.0 / 0.0)
  assert_eq(t.almost_equal(other, delta=-1.0), false)
  assert_eq(t.almost_equal(other, delta=0.0), false)
  assert_eq(t.almost_equal(other, delta=1.0), false)
  assert_eq(t.almost_equal(other, delta=1.0 / 0.0), false)
  assert_eq(t.almost_equal(other, delta=0.0 / 0.0), false)
  assert_eq(t.strictly_equal(other), false)
  assert_eq(t.equals(other), false)
  assert_eq(t.greater(other), false)
  assert_eq(t.greater_equal(other), false)
  assert_eq(t.less(other), true)
  assert_eq(t.less_equal(other), true)
  let actual = t.add(other)
  api_number(actual.value, 0.0 / 0.0)
  api_number(actual.rate, -1.0)
  let actual = t.subtract(other)
  api_number(actual.value, 0.0 / 0.0)
  api_number(actual.rate, -1.0)
  let actual = @opentime.duration_from_start_end_time(t, other, inclusive=false)
  api_number(actual.value, 0.0 / 0.0)
  api_number(actual.rate, -1.0)
  let actual = @opentime.duration_from_start_end_time(t, other, inclusive=true)
  api_number(actual.value, 0.0 / 0.0)
  api_number(actual.rate, -1.0)
}

