///|
test "time:50" {
  let t = @opentime.RationalTime::new(value=1.0 / 0.0, rate=1.0)
  assert_eq(t.is_valid_time(), true)
  assert_eq(t.is_invalid_time(), false)
  api_number(t.to_seconds(), 1.0 / 0.0)
