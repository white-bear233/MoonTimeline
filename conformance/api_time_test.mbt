  let actual = t.ceil()
  api_number(actual.value, 1.0)
  api_number(actual.rate, 1.0 / 0.0)
  let actual = t.round()
  api_number(actual.value, 1.0)
  api_number(actual.rate, 1.0 / 0.0)
  let actual = t.rescaled_to(-1.0)
