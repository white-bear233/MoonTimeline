test "time:42" {
  let t = @opentime.RationalTime::new(value=1000000000.0, rate=1.0)
  assert_eq(t.is_valid_time(), true)
  assert_eq(t.is_invalid_time(), false)
  api_number(t.to_seconds(), 1000000000.0)
  let actual = t.floor()
  api_number(actual.value, 1000000000.0)
  api_number(actual.rate, 1.0)
  let actual = t.ceil()
  api_number(actual.value, 1000000000.0)
  api_number(actual.rate, 1.0)
  let actual = t.round()
  api_number(actual.value, 1000000000.0)
  api_number(actual.rate, 1.0)
  let actual = t.rescaled_to(-1.0)
  api_number(actual.value, -1000000000.0)
