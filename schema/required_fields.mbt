// Generated by removing each field and asking official OTIO to deserialize.

///|
fn required_fields(name : String) -> Array[String] {
  match name {
    "Adapter" => []
    "Box2d" => ["min", "max"]
    "Clip" => ["media_references", "active_media_reference_key"]
    "Color" => ["r", "g", "b", "a", "name"]
    "Composable" => []
    "Composition" => ["children"]
    "Effect" => ["effect_name"]
    "ExternalReference" => ["target_url"]
    "FreezeFrame" => ["effect_name", "time_scalar"]
    "Gap" => []
    "GeneratorReference" => ["generator_kind", "parameters"]
    "HookScript" => []
    "ImageSequenceReference" =>
      [
        "target_url_base", "name_prefix", "name_suffix", "start_frame", "frame_step",
        "rate", "frame_zero_padding", "missing_frame_policy",
      ]
    "Item" => []
    "LinearTimeWarp" => ["effect_name", "time_scalar"]
    "Marker" => ["marked_range"]
    "MediaLinker" => []
    "MediaReference" => []
    "MissingReference" => []
    "PluginManifest" => []
    "RationalTime" => ["rate", "value"]
    "SchemaDef" => []
    "SerializableCollection" => ["children"]
    "SerializableObject" => []
    "SerializableObjectWithMetadata" => []
    "Stack" => ["children"]
    "TimeEffect" => ["effect_name"]
    "TimeRange" => ["duration", "start_time"]
    "TimeTransform" => ["offset", "rate", "scale"]
    "Timeline" => ["tracks"]
    "Track" => ["children", "kind"]
    "Transition" => ["in_offset", "out_offset", "transition_type"]
    "V2d" => ["x", "y"]
    _ => []
  }
}
